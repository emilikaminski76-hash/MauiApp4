 <?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp4.NewPage1"
             Title="NewPage1">
    <VerticalStackLayout>
        <Label 
            Text="France"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
        <Grid ColumnDefinitions=" *,*,*" HeightRequest="200">
            <BoxView BackgroundColor="Blue" Grid.Column=" 0"/>
            <BoxView BackgroundColor="White"  Grid.Column=" 1"/>
            <BoxView BackgroundColor="Red"  Grid.Column=" 2"/>
        </Grid>
        <Label 
            Text="Germany"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
        <Grid ColumnDefinitions=" *,*,*" HeightRequest="200">
            <BoxView BackgroundColor="Black"  Grid.Column=" 0"/>
            <BoxView BackgroundColor="Yellow"   Grid.Column=" 1"/>
            <BoxView BackgroundColor="Red"   Grid.Column=" 2"/>
        </Grid>
        <Label 
            Text="switzerland"
    VerticalOptions="Center"
    HorizontalOptions="Center" />
        <Grid BackgroundColor=" red" HeightRequest="200">
            <BoxView 
                BackgroundColor="White" 
                WidthRequest=" 50"
                HeightRequest=" 150"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
            <BoxView 
                BackgroundColor="White" WidthRequest=" 50"
                HeightRequest=" 150"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>
        <Label 
                Text="israel"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
                <Grid BackgroundColor="White"  HeightRequest="200">
            <BoxView 
            BackgroundColor="blue" 
            HeightRequest ="20"
            VerticalOptions="Start" 
            Margin="0,35,0,0"/>
            <BoxView 
            BackgroundColor="blue" 
            HeightRequest=" 20"
            VerticalOptions="Start" 
            Margin="0,35,0,0"/>
            <Image 
                Source="triangle.png"
                WidthRequest="100"
                HeightRequest="100"
                HorizontalOptions="Center"
                VerticalOptions="Center" 
                Margin="0,-15,0,0"/>
            <Image 
                Source="triangle.png"
                WidthRequest="100"
                HeightRequest="100"
                HorizontalOptions="Center"
                VerticalOptions="Center" 
                Rotation="180"
                Margin="0,15,0,0"/>
             </Grid>
        <Label
            Text="Canada"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
        <Grid ColumnDefinitions="*,2*,*" HeightRequest="200">
            <BoxView BackgroundColor="red" Grid.Column="0"/>
            <BoxView BackgroundColor="White"  Grid.Column="1"/>
            <BoxView BackgroundColor="red" Grid.Column="2"/>
            <Image 
                Source="redleaf.png"
                Grid.Column="1"
                 WidthRequest="100"
                 HeightRequest="100"
                 HorizontalOptions="Center"
                 VerticalOptions="Center" />
            </Grid>


    </VerticalStackLayout>
</ContentPage>